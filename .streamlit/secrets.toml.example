# Copy this file to .streamlit/secrets.toml (gitignored) and add your
# Hugging Face token. A free "Read" token from
# https://huggingface.co/settings/tokens is enough. It powers the optional
# AI insights brief and follow-up Q&A in the Batch Analyze and
# Train on Your Own Data tabs. Everything else works without it.
#
# On Streamlit Community Cloud, paste the same line into the app's
# Settings -> Secrets box instead of uploading this file.

HF_TOKEN = "hf_your_token_here"
